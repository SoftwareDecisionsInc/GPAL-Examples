<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <ProjectGuid>{0CA079C5-F79B-4A4D-AAF0-F5B8C1B2C3E8}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <RootNamespace>ConverterTestor</RootNamespace>
    <AssemblyName>ConverterTestor</AssemblyName>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <Deterministic>true</Deterministic>
    <ApplicationIcon>gpal-head.ico</ApplicationIcon>
    <!-- the old project format turned this on by default for programs; the SDK does not -->
    <Prefer32Bit>true</Prefer32Bit>
    <!-- AssemblyInfo.cs holds the version and the rest; the SDK must not write them a second time -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- bin\Debug and bin\Release as before, without a net48 folder under them -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <PlatformTarget>x64</PlatformTarget>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

